<mxfile host="app.diagrams.net"><diagram name="03_Average_Speed_Calculator"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Start" style="shape=terminator;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="220" height="50" as="geometry" /></mxCell><mxCell id="3" value="Input distance1, time1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="220" height="50" as="geometry" /></mxCell><mxCell id="4" edge="1" parent="1" source="2" target="3" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="5" value="Input distance2, time2" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="220" width="220" height="50" as="geometry" /></mxCell><mxCell id="6" edge="1" parent="1" source="3" target="5" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="7" value="speed1 = distance1 / time1" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="310" width="220" height="50" as="geometry" /></mxCell><mxCell id="8" edge="1" parent="1" source="5" target="7" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="9" value="speed2 = distance2 / time2" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="400" width="220" height="50" as="geometry" /></mxCell><mxCell id="10" edge="1" parent="1" source="7" target="9" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" value="total_distance = distance1 + distance2" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="490" width="220" height="50" as="geometry" /></mxCell><mxCell id="12" edge="1" parent="1" source="9" target="11" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" value="total_time = time1 + time2" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="580" width="220" height="50" as="geometry" /></mxCell><mxCell id="14" edge="1" parent="1" source="11" target="13" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="average_speed = total_distance / total_time" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="670" width="220" height="50" as="geometry" /></mxCell><mxCell id="16" edge="1" parent="1" source="13" target="15" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="Print results" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="760" width="220" height="50" as="geometry" /></mxCell><mxCell id="18" edge="1" parent="1" source="15" target="17" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="Stop" style="shape=terminator;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="850" width="220" height="50" as="geometry" /></mxCell><mxCell id="20" edge="1" parent="1" source="17" target="19" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>